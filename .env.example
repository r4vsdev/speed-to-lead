# Copy to .env and fill in. Never commit .env.

# Which CRM receives leads: hubspot | salesforce | dryrun
CRM=dryrun

# Shared secret the website form sends in the X-Webhook-Secret header
WEBHOOK_SECRET=

# HubSpot private app token (scopes: crm.objects.contacts/companies/deals read+write)
HUBSPOT_TOKEN=

# Salesforce (filled in later)
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Optional: alert the sales rep on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where the lead log lives
DB_PATH=data/leads.db
