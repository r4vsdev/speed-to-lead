# Copy to .env and fill in. Never commit .env.

# Which CRM receives leads: hubspot | salesforce | dryrun
CRM=dryrun

# Shared secret sent in the X-Webhook-Secret header (required unless CRM=dryrun).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Max POSTs per client IP per minute
RATE_LIMIT_PER_MIN=30

# HubSpot service key (scopes: crm.objects.contacts/companies/deals read+write)
HUBSPOT_TOKEN=

# Salesforce External Client App (OAuth client credentials flow)
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Only used to build "Open in HubSpot" links in alerts
HUBSPOT_PORTAL_ID=

# Alerts: Slack incoming webhook and/or Telegram (both optional; without them alerts go to the log)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Enrichment: read the lead's company website (1 = on, 0 = off)
ENRICH_WEBSITES=1

# AI enrichment, any OpenAI-compatible API. Local and free with Ollama:
#   LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=qwen3:8b  LLM_REASONING_EFFORT=none
# Leave LLM_BASE_URL empty to score with rules only.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_REASONING_EFFORT=

# Routing rules and owners (JSON, see routing.example.json). Empty = built-in default.
ROUTING_FILE=

# Where the lead log lives
DB_PATH=data/leads.db
