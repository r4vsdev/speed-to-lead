  "rules": [
    {
      "when": {
        "grade": [
          "spam"
        ]
      },
      "assign": "nurture"
    },
    {
      "when": {
        "min_score": 70
      },
      "assign": "ae"
    },
    {
      "when": {
        "industry": [
          "healthcare",
          "finance"
        ]
      },
